# 회사 로그인 정보
# 주의: 자동 로그인하지 않습니다! 브라우저에서 수동으로 로그인해야 합니다.
COMPANY_LOGIN_URL=https://your-company-login.com
VACATION_PAGE_URL=https://your-company-vacation-page.com

# 로그인 확인 설정 (선택사항)
# 로그인된 사용자만 볼 수 있는 요소의 선택자를 지정할 수 있습니다
# LOGIN_INDICATOR_SELECTOR=.user-profile

# 로그인 재시도 설정
LOGIN_CHECK_RETRY_INTERVAL=600000      # 재시도 간격 (밀리초, 기본: 10분)
LOGIN_CHECK_MAX_DURATION=7200000       # 최대 대기 시간 (밀리초, 기본: 2시간)

# Confluence 설정 (Playwright로 직접 편집)
# 주의: Confluence도 수동으로 미리 로그인되어 있어야 합니다!
CONFLUENCE_PAGE_URL=https://your-confluence.atlassian.net/wiki/spaces/TEAM/pages/123456789/Team+Calendar

# 스케줄 설정 (cron 형식: 분 시 일 월 요일)
# 예: "0 9 * * 1-5" = 평일 오전 9시
CRON_SCHEDULE=0 9 * * 1-5

# 브라우저 설정
HEADLESS=true
BROWSER_TIMEOUT=30000

# 세션 저장/복원 (WSL 환경에서 유용)
USE_SAVED_SESSION=false              # true로 설정하면 세션 저장/복원 활성화
SESSION_FILE=./auth-state.json       # 세션 저장 파일 경로

# Remote Browser (WSL에서 Windows Chrome 사용)
# CHROME_REMOTE_DEBUGGING_URL=http://localhost:9222

# 데이터 저장 경로
DATA_DIR=./data
